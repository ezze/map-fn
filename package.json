{
  "name": "map-fn",
  "version": "0.4.0",
  "description": "A set of utility functions to map one type of values to another one with ease",
  "keywords": [
    "map",
    "mapping",
    "transform",
    "transformation"
  ],
  "author": {
    "name": "Dmitriy Pushkov",
    "email": "ezze@ezze.org",
    "url": "https://ezze.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezze/map-fn"
  },
  "bugs": {
    "url": "https://github.com/ezze/map-fn/issues"
  },
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.es.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.es.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint lib",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm build"
  },
  "prettier": "prettier-config-ezze",
  "devDependencies": {
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "eslint": "^10.10.0",
    "eslint-config-ezze-prettier": "1.0.0-alpha.2",
    "eslint-config-ezze-ts": "1.0.0-alpha.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jiti": "^2.4.2",
    "prettier": "^3.9.6",
    "prettier-config-ezze": "^1.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.1.0",
    "vite-plugin-checker": "^0.8.0",
    "vite-plugin-dts": "^4.5.0"
  }
}
